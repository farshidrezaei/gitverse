{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitVerse",
  "version": "1.0.0",
  "identifier": "com.gitverse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitVerse",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
