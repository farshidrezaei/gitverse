{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitVerse",
  "version": "1.0.0",
  "identifier": "com.gitverse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitVerse",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Modern, Cross-Platform, Local-First Git Desktop Client",
    "longDescription": "GitVerse combines the raw power of the native Git CLI with an in-house commit graph engine, interactive diff/patch manipulation, zero-layout-shift design, and seamless GitHub/GitLab integration into an ultra-fast desktop experience.",
    "copyright": "Copyright © 2024-2026 GitVerse Contributors",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libsecret-1-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libayatana-appindicator",
          "librsvg2",
          "libsecret"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowPosition": {
          "x": 400,
          "y": 200
        },
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1OTQ5N0U3NjJGMTc0QzgKUldUSWRQRmk1NWVVbFFZS014Nzc1RXFCajFPVThxMDlnWTZPaDhkTlhLWThIakZLVHNmYkdkZEEK",
      "endpoints": [
        "https://github.com/farshidrezaei/gitverse/releases/latest/download/latest.json"
      ]
    }
  }
}
