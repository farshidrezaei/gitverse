{
  "name": "gitverse",
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first, cross-platform Git client with custom commit graph, diff engine, and provider integrations.",
  "license": "MIT",
  "author": "GitVerse Contributors",
  "homepage": "https://github.com/farshid/gitverse",
  "repository": {
    "type": "git",
    "url": "https://github.com/farshid/gitverse.git"
  },
  "bugs": {
    "url": "https://github.com/farshid/gitverse/issues"
  },
  "keywords": [
    "git",
    "git-client",
    "desktop",
    "tauri",
    "vue",
    "nuxt",
    "commit-graph",
    "diff-viewer"
  ],
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "node scripts/patch-nuxt-ui.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "test:unit": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@iconify-json/lucide": "^1.2.153",
    "@iconify-json/simple-icons": "^1.2.103",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "maska": "^3.2.2",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.4.0",
    "@tauri-apps/cli": "^2.12.4",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.3.14"
  }
